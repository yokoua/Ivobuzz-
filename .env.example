# Example environment variables for Ivobuzz
# - Do not commit real secrets. Keep sensitive values out of this file.
# - Variables exposed to the client (Vite) must start with VITE_

VITE_API_URL=https://api.ivobuzz.example
VITE_PUBLIC_KEY=pk_test_xxx
NODE_ENV=production
SECRET_API_KEY=sk_live_xxx
OTHER_BUILD_FLAG=true
